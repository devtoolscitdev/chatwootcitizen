<div class="w-full">
  <% regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data) %>

  <div class="mb-4">
    <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Recursos Padrão</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      <% regular_features.each do |key_array, val| %>
        <% feature_key, display_name = key_array %>
        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-slate-200 shadow-sm">
          <span class="text-sm font-medium text-slate-700"><%= display_name %></span>
          <% if val.present? %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Visível
            </span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200">
              Invisível
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <hr class="my-6 border-slate-200">

  <div>
    <div class="flex items-center gap-2 mb-3">
      <span class="text-amber-500 flex items-center">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M480 224l-186.828 7.487L401.688 64l-59.247-32L256 208 169.824 32l-59.496 32 108.5 167.487L32 224v64l185.537-10.066L113.65 448l55.969 32L256 304l86.381 176 55.949-32-103.867-170.066L480 288z" fill="currentColor"/></svg>
      </span>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Recursos Avançados / Premium (Audit Logs, Captain, SLA, SAML, Roles, etc.)</h4>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      <% premium_features.each do |key_array, val| %>
        <% feature_key, display_name = key_array %>
        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-slate-200 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="text-amber-500">
              <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M480 224l-186.828 7.487L401.688 64l-59.247-32L256 208 169.824 32l-59.496 32 108.5 167.487L32 224v64l185.537-10.066L113.65 448l55.969 32L256 304l86.381 176 55.949-32-103.867-170.066L480 288z" fill="currentColor"/></svg>
            </span>
            <span class="text-sm font-medium text-slate-700"><%= display_name %></span>
          </div>
          <% if val.present? %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Visível
            </span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200">
              Invisível
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
